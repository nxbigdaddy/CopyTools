<Window x:Class="CopyTools.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CopyTools 文件复制与同步"
        Width="1240"
        Height="820"
        MinWidth="980"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource PageBackgroundBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="50" ResizeBorderThickness="6"
                            CornerRadius="10" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{x:Static ApplicationCommands.Help}" />
        <KeyBinding Key="P" Modifiers="Control" Command="{Binding PreviewCommand}" />
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding ExecuteCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveTaskCommand}" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static ApplicationCommands.Help}" Executed="HelpCommand_OnExecuted" />
    </Window.CommandBindings>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}">
            <Grid MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Margin="14,9,10,9" Width="32" Height="32" CornerRadius="9"
                        Background="{DynamicResource PrimaryBrush}">
                    <TextBlock Text="C" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontFamily="Segoe UI" FontSize="17" FontWeight="Bold" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="CopyTools" FontSize="15" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Margin="10,0,0,0" Text="文件复制与同步" FontSize="12"
                               Foreground="#AFC0D6" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="2" Margin="0,0,16,0" Text="安全复制 · 可追踪 · 可恢复"
                           Foreground="#AFC0D6" FontSize="11" VerticalAlignment="Center" />
                <Button Grid.Column="3" Width="80" Content="?  帮助" Click="Help_OnClick"
                        ToolTip="打开 CopyTools 使用帮助 (F1)"
                        Style="{StaticResource TitleBarButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Grid.Column="4" Content="—" Click="Minimize_OnClick" ToolTip="最小化"
                        Style="{StaticResource TitleBarButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button x:Name="MaximizeButton" Grid.Column="5" Content="□" Click="MaximizeRestore_OnClick" ToolTip="最大化"
                        Style="{StaticResource TitleBarButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                <Button Grid.Column="6" Content="×" Click="Close_OnClick" ToolTip="关闭"
                        Style="{StaticResource CloseTitleBarButtonStyle}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,18,22,18">
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,4,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="任务中心"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Text="配置、预览并安全执行文件复制、同步与备份任务。"
                           Margin="0,4,0,0"
                           FontSize="13"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="新建复制任务" Command="{Binding NewCopyTaskCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                <Button Margin="8,0,0,0" Content="新建同步任务" Command="{Binding NewSyncTaskCommand}" Style="{DynamicResource SecondaryButtonStyle}" />
                <Border Margin="12,0,0,0" Padding="12,7" Background="{DynamicResource BadgeBrush}" CornerRadius="16">
                    <TextBlock Text="1.1 · 体验升级版" Foreground="{DynamicResource BadgeTextBrush}" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Grid>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="0,2,0,0"
                    Background="Transparent" BorderThickness="0"
                    Style="{StaticResource WorkspaceTabControlStyle}">
            <TabItem Header="复制任务">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="20"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="310" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="任务名称" FontWeight="SemiBold" />
                                    <TextBox Grid.Column="1" Text="{Binding TaskName, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <Grid Grid.Row="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="88" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="源路径" FontWeight="SemiBold" />
                                    <TextBox Grid.Column="1" Height="64" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                                             Text="{Binding SourcePathsText, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Grid.Column="3">
                                        <Button Content="加目录…" Command="{Binding BrowseSourceCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Margin="0,5,0,0" Content="加文件…" Command="{Binding AddSourceFilesCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                        <Button Margin="0,5,0,0" Content="清空" Command="{Binding ClearSourcePathsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="88" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="88" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="目标目录" FontWeight="SemiBold" />
                                    <TextBox Grid.Column="1" Text="{Binding TargetDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Grid.Column="3" Content="浏览…" Command="{Binding BrowseTargetCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                            </Grid>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="复制模式" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                                          DisplayMemberPath="Name" />
                                <TextBlock Text="{Binding ModeDescription}" Margin="2,8,0,14" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <Button Content="保存任务配置" Command="{Binding SaveTaskCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Expander Grid.Row="1" Header="高级设置：过滤、校验与重试" Margin="0,12,0,0">
                        <ScrollViewer Margin="0,8,0,0" MaxHeight="390" VerticalScrollBarVisibility="Auto">
                        <Border Padding="18" Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="包含文件" FontWeight="SemiBold" />
                                    <TextBox Margin="0,6,0,4" Text="{Binding IncludePatternsText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="用分号分隔，例如：*.docx; *.pdf" Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Text="排除文件" FontWeight="SemiBold" Margin="0,12,0,0" />
                                    <TextBox Margin="0,6,0,4" Text="{Binding ExcludePatternsText, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Margin="0,10,0,0" Content="包含隐藏文件" IsChecked="{Binding IncludeHiddenFiles}" />
                                    <CheckBox Margin="0,6,0,0" Content="包含系统文件" IsChecked="{Binding IncludeSystemFiles}" />
                                    <TextBlock Text="符号链接/联接点" FontWeight="SemiBold" Margin="0,12,0,0" />
                                    <ComboBox Margin="0,6,0,0" ItemsSource="{Binding ReparsePointOptions}"
                                              SelectedItem="{Binding SelectedReparsePoint}" DisplayMemberPath="Name" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="排除目录" FontWeight="SemiBold" />
                                    <TextBox Margin="0,6,0,4" Text="{Binding ExcludedDirectoriesText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="例如：cache; bin; obj" Foreground="{DynamicResource MutedTextBrush}" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="最小大小（MB）" FontWeight="SemiBold" />
                                            <TextBox Margin="0,6,0,0" Text="{Binding MinimumSizeMbText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="最大大小（MB）" FontWeight="SemiBold" />
                                            <TextBox Margin="0,6,0,0" Text="{Binding MaximumSizeMbText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="最早修改日期" FontWeight="SemiBold" />
                                            <TextBox Margin="0,6,0,0" Text="{Binding ModifiedAfterText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="最晚修改日期" FontWeight="SemiBold" />
                                            <TextBox Margin="0,6,0,0" Text="{Binding ModifiedBeforeText, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="完成校验" FontWeight="SemiBold" />
                                    <ComboBox Margin="0,6,0,4" ItemsSource="{Binding VerificationOptions}"
                                              SelectedItem="{Binding SelectedVerification}" DisplayMemberPath="Name" />
                                    <TextBlock Text="{Binding VerificationDescription}" TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Text="插件追加校验" FontWeight="SemiBold" Margin="0,12,0,0" />
                                    <ComboBox Margin="0,6,0,0" ItemsSource="{Binding PluginVerificationOptions}"
                                              SelectedItem="{Binding SelectedPluginVerification}" DisplayMemberPath="Name" />
                                    <TextBlock Text="同名文件策略" FontWeight="SemiBold" Margin="0,12,0,0" />
                                    <ComboBox Margin="0,6,0,0" ItemsSource="{Binding ExistingFilePolicies}"
                                              SelectedItem="{Binding SelectedExistingFilePolicy}" DisplayMemberPath="Name" />
                                    <TextBlock Text="双向冲突策略" FontWeight="SemiBold" Margin="0,12,0,0" />
                                    <ComboBox Margin="0,6,0,0" ItemsSource="{Binding ConflictResolutionOptions}"
                                              SelectedItem="{Binding SelectedConflictResolution}" DisplayMemberPath="Name" />
                                    <TextBlock Text="失败最大尝试次数" FontWeight="SemiBold" Margin="0,12,0,0" />
                                    <TextBox Margin="0,6,0,0" Text="{Binding MaxAttempts, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="失败重试间隔（秒）" FontWeight="SemiBold" Margin="0,12,0,0" />
                                    <TextBox Margin="0,6,0,0" Text="{Binding RetryDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="设备/网络断开最长等待（分钟，0=不等待）" FontWeight="SemiBold" Margin="0,12,0,0" />
                                    <TextBox Margin="0,6,0,0" Text="{Binding AvailabilityWaitMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                    <CheckBox Margin="0,10,0,0" Content="保留 NTFS 访问控制权限（仅 Windows NTFS）" IsChecked="{Binding PreserveNtfsPermissions}" />
                                    <CheckBox Margin="0,8,0,0" Content="保存任务时将盘符转换为稳定卷 GUID 路径" IsChecked="{Binding UseStableVolumePaths}" />
                                    <CheckBox Margin="0,8,0,0" Content="覆盖前保存旧版本" IsChecked="{Binding PreserveOverwrittenFiles}" />
                                    <TextBlock Text="旧版本保存目录" FontWeight="SemiBold" Margin="0,8,0,0" />
                                    <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding VersionsDirectory}"/><Button Grid.Column="2" Content="浏览…" Command="{Binding BrowseVersionsDirectoryCommand}" Style="{DynamicResource SecondaryButtonStyle}"/></Grid>
                                    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="每文件保留数量"/><TextBox Margin="0,4,0,0" Text="{Binding VersionKeepLatest}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="保留天数"/><TextBox Margin="0,4,0,0" Text="{Binding VersionKeepDays}"/></StackPanel></Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="最大隔离数" FontWeight="SemiBold" />
                                            <TextBox Margin="0,6,0,0" Text="{Binding MaximumDeleteItems, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="最大隔离比例%" FontWeight="SemiBold" />
                                            <TextBox Margin="0,6,0,0" Text="{Binding MaximumDeletePercentage, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="缓冲区 KB" FontWeight="SemiBold" />
                                            <TextBox Margin="0,6,0,0" Text="{Binding BufferSizeKb, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="限速 MB/s" FontWeight="SemiBold" />
                                            <TextBox Margin="0,6,0,0" Text="{Binding SpeedLimitMbPerSecond, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="并发文件" FontWeight="SemiBold" />
                                            <TextBox Margin="0,6,0,0" Text="{Binding MaxParallelFiles, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Margin="0,8,0,0" Content="按文件规模与存储介质自动调优并发（并发文件数作为上限）" IsChecked="{Binding AutoTunePerformance}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        </ScrollViewer>
                    </Expander>

                    <Border Grid.Row="2" Margin="0,12,0,0" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="20,14,20,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="操作预览" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding PlanSummary}" Margin="0,5,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding DestructivePlanSummary}" Margin="0,3,0,0"
                                               Foreground="{DynamicResource WarningBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Button Content="生成预览" Command="{Binding PreviewCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Margin="0,6,0,0" Content="排除勾选项" Command="{Binding ExcludeSelectedPlanItemsCommand}" Style="{StaticResource SecondaryButtonStyle}" />
                                    <ComboBox Margin="0,6,0,0" Width="125" ItemsSource="{Binding PlanFilters}" SelectedItem="{Binding SelectedPlanFilter}" ToolTip="按变更类型筛选预览" />
                                </StackPanel>
                            </Grid>
                            <DataGrid x:Name="PlanGrid" Grid.Row="1" ItemsSource="{Binding PlanItemsView}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                      GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0"
                                      AlternatingRowBackground="{DynamicResource AlternateRowBrush}">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="排除" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="65" IsReadOnly="False" />
                                    <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="110" />
                                    <DataGridTextColumn Header="相对路径" Binding="{Binding RelativePath}" Width="*" />
                                    <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="110" />
                                    <DataGridTextColumn Header="原因" Binding="{Binding Reason}" Width="260" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="已保存任务">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Padding="18" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="已保存任务" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="加载任务只会恢复配置，仍需预览和确认后才能执行。"
                                           Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="加载所选" Command="{Binding LoadTaskCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Grid.Column="3" Content="删除所选" Command="{Binding DeleteTaskCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="5" Content="复制任务" Command="{Binding DuplicateTaskCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="7" Content="导入" Command="{Binding ImportTasksCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="9" Content="导出全部" Command="{Binding ExportTasksCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </Grid>
                        <DataGrid Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding SavedTasks}"
                                  SelectedItem="{Binding SelectedSavedTask}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  BorderThickness="0" RowHeaderWidth="0" AlternatingRowBackground="{DynamicResource AlternateRowBrush}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="队列" Binding="{Binding IsQueueSelected}" Width="60" IsReadOnly="False"/>
                                <DataGridTextColumn Header="任务名称" Binding="{Binding Name}" Width="200" />
                                <DataGridTextColumn Header="模式" Binding="{Binding Mode}" Width="110" />
                                <DataGridTextColumn Header="组" Binding="{Binding Group}" Width="110" />
                                <DataGridTextColumn Header="优先级" Binding="{Binding Priority}" Width="75" />
                                <DataGridTextColumn Header="依赖" Binding="{Binding Dependencies}" Width="75" />
                                <DataGridTextColumn Header="源目录" Binding="{Binding Source}" Width="*" />
                                <DataGridTextColumn Header="目标目录" Binding="{Binding Target}" Width="*" />
                                <DataGridTextColumn Header="最近运行" Binding="{Binding LastRunAt}" Width="165" />
                                <DataGridTextColumn Header="结果" Binding="{Binding LastResult}" Width="85" />
                                <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt}" Width="170" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    </Border>
                    <Border Grid.Row="2" Padding="18" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="所选任务编排" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,10,0,0" Text="说明" FontWeight="SemiBold"/>
                                <TextBox Margin="0,5,0,0" Text="{Binding OrchestrationDescription, UpdateSourceTrigger=PropertyChanged}"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="分组" FontWeight="SemiBold"/><TextBox Margin="0,5,0,0" Text="{Binding OrchestrationGroup}"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="优先级" FontWeight="SemiBold"/><TextBox Margin="0,5,0,0" Text="{Binding OrchestrationPriority}"/></StackPanel>
                                </Grid>
                                <TextBlock Margin="0,10,0,0" Text="标签（分号分隔）" FontWeight="SemiBold"/>
                                <TextBox Margin="0,5,0,0" Text="{Binding OrchestrationTags}"/>
                                <TextBlock Margin="0,10,0,0" Text="依赖任务名称或 ID（分号分隔）" FontWeight="SemiBold"/>
                                <TextBox Margin="0,5,0,0" Text="{Binding OrchestrationDependencies}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="受控前后置命令" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,10,0,0" Text="前置可执行文件绝对路径" FontWeight="SemiBold"/>
                                <TextBox Margin="0,5,0,0" Text="{Binding BeforeCommandPath}"/>
                                <TextBlock Margin="0,8,0,0" Text="前置参数（空格分隔，含空格参数使用双引号）" FontWeight="SemiBold"/>
                                <TextBox Margin="0,5,0,0" Text="{Binding BeforeCommandArguments}"/>
                                <TextBlock Margin="0,10,0,0" Text="后置可执行文件绝对路径" FontWeight="SemiBold"/>
                                <TextBox Margin="0,5,0,0" Text="{Binding AfterCommandPath}"/>
                                <TextBlock Margin="0,8,0,0" Text="后置参数" FontWeight="SemiBold"/>
                                <TextBox Margin="0,5,0,0" Text="{Binding AfterCommandArguments}"/>
                                <CheckBox Margin="0,10,0,0" Content="任务失败时仍运行后置命令" IsChecked="{Binding RunAfterCommandOnFailure}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="队列执行" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,10,0,0" Text="最大并发任务（1–16）" FontWeight="SemiBold"/>
                                <TextBox Margin="0,5,0,0" Text="{Binding MaximumParallelTasks}"/>
                                <TextBlock Margin="0,10,0,0" Text="{Binding QueueSummary}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                                <Button Margin="0,14,0,0" Content="保存所选编排" Command="{Binding SaveOrchestrationCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Margin="0,8,0,0" Content="运行勾选任务队列" Command="{Binding RunTaskQueueCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                                <TextBlock Margin="0,10,0,0" Text="命令按参数数组直接启动，不经过 cmd.exe 或 PowerShell。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="运行历史">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="430" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="16" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="最近运行" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Content="导出所选" Margin="12,0,0,0" Command="{Binding ExportRunLogCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                    <Button Content="加载并重跑" Margin="8,0,0,0" Command="{Binding RerunSelectedHistoryCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="打开数据目录" Command="{Binding OpenDataDirectoryCommand}" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="8,0,0,0" Content="刷新" Command="{Binding RefreshHistoryCommand}" Style="{StaticResource SecondaryButtonStyle}" /></StackPanel>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="80"/><ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="92"/><ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="92"/><ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding HistoryTaskFilter}" ToolTip="任务名称包含"/>
                                <TextBox Grid.Column="2" Text="{Binding HistoryStatusFilter}" ToolTip="状态，如 成功"/>
                                <TextBox Grid.Column="4" Text="{Binding HistoryFromText}" ToolTip="开始日期 yyyy-MM-dd"/>
                                <TextBox Grid.Column="6" Text="{Binding HistoryToText}" ToolTip="结束日期 yyyy-MM-dd"/>
                                <Button Grid.Column="8" Content="查询" Command="{Binding QueryHistoryCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                            </Grid>
                            <DataGrid Grid.Row="2" Margin="0,12,0,0" ItemsSource="{Binding RunHistory}"
                                      SelectedItem="{Binding SelectedRun}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="完成时间" Binding="{Binding CompletedAt}" Width="145" />
                                    <DataGridTextColumn Header="任务" Binding="{Binding TaskName}" Width="*" />
                                    <DataGridTextColumn Header="结果" Binding="{Binding Status}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Padding="16" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="逐文件结果" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding SelectedRun.Summary}" Margin="0,4,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <DataGrid Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding SelectedRun.Items}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0"
                                      AlternatingRowBackground="{DynamicResource AlternateRowBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="文件" Binding="{Binding RelativePath}" Width="*" />
                                    <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="100" />
                                    <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="80" />
                                    <DataGridTextColumn Header="尝试" Binding="{Binding Attempts}" Width="65" />
                                    <DataGridTextColumn Header="错误" Binding="{Binding Error}" Width="260" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="隔离区">
                <Border Margin="0,12,0,0" Padding="18" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="可恢复的隔离文件" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="镜像和移动同步不会永久删除文件；选择记录可恢复到原始位置。"
                                           Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshQuarantineCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Grid.Column="3" Content="恢复所选" Command="{Binding RestoreQuarantineCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                        </Grid>
                        <DataGrid Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding QuarantineEntries}"
                                  SelectedItem="{Binding SelectedQuarantineEntry}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                  BorderThickness="0" RowHeaderWidth="0" AlternatingRowBackground="{DynamicResource AlternateRowBrush}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="隔离时间" Binding="{Binding QuarantinedAt}" Width="160" />
                                <DataGridTextColumn Header="相对路径" Binding="{Binding RelativePath}" Width="220" />
                                <DataGridTextColumn Header="原始位置" Binding="{Binding OriginalPath}" Width="*" />
                                <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="100" />
                                <DataGridTextColumn Header="隔离文件" Binding="{Binding QuarantinePath}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="计划任务">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="390" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="18" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="新建或更新计划" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="先保存复制任务，再为它配置自动运行计划。自动覆盖和自动隔离默认关闭。"
                                           Margin="0,4,0,14" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="任务" FontWeight="SemiBold" />
                                <ComboBox Margin="0,6,0,12" ItemsSource="{Binding SavedTasks}"
                                          SelectedItem="{Binding SelectedTaskForSchedule}" DisplayMemberPath="Name" />
                                <TextBlock Text="触发方式" FontWeight="SemiBold" />
                                <ComboBox Margin="0,6,0,12" ItemsSource="{Binding ScheduleTriggers}"
                                          SelectedItem="{Binding SelectedScheduleTrigger}" DisplayMemberPath="Name" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="本地时间" FontWeight="SemiBold" />
                                        <TextBox Margin="0,6,0,0" Text="{Binding ScheduleTimeText, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="间隔分钟" FontWeight="SemiBold" />
                                        <TextBox Margin="0,6,0,0" Text="{Binding ScheduleIntervalMinutes, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="每周日期" FontWeight="SemiBold" />
                                        <ComboBox Margin="0,6,0,0" ItemsSource="{Binding ScheduleDays}"
                                                  SelectedItem="{Binding SelectedScheduleDay}" DisplayMemberPath="Name" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="每月日期" FontWeight="SemiBold" />
                                        <TextBox Margin="0,6,0,0" Text="{Binding ScheduleDayOfMonth, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox Margin="0,16,0,0" Content="启用计划" IsChecked="{Binding ScheduleEnabled}" />
                                <CheckBox Margin="0,8,0,0" Content="错过计划后立即补跑" IsChecked="{Binding ScheduleRunMissed}" />
                                <CheckBox Margin="0,8,0,0" Content="允许自动覆盖已有文件"
                                          IsChecked="{Binding ScheduleAllowOverwrite}" Foreground="{DynamicResource WarningBrush}" />
                                <CheckBox Margin="0,8,0,16" Content="允许自动隔离或清理文件"
                                          IsChecked="{Binding ScheduleAllowQuarantine}" Foreground="{DynamicResource WarningBrush}" />
                                <Button Content="保存计划" Command="{Binding SaveScheduleCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="2" Padding="18" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="已有计划" FontSize="20" FontWeight="SemiBold" />
                                <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshSchedulesCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Grid.Column="3" Content="立即运行" Command="{Binding RunScheduleNowCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}" />
                                <Button Grid.Column="5" Content="删除" Command="{Binding DeleteScheduleCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                            <DataGrid Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding Schedules}"
                                      SelectedItem="{Binding SelectedSchedule}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal"
                                      BorderThickness="0" RowHeaderWidth="0" AlternatingRowBackground="{DynamicResource AlternateRowBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="任务" Binding="{Binding Name}" Width="180" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding Enabled}" Width="70" />
                                    <DataGridTextColumn Header="触发" Binding="{Binding Trigger}" Width="120" />
                                    <DataGridTextColumn Header="下次运行" Binding="{Binding NextRun}" Width="170" />
                                    <DataGridTextColumn Header="自动安全授权" Binding="{Binding Safety}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="版本备份与恢复">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="400" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="18" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="创建版本备份" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="同步用于传播当前状态；版本备份用于恢复历史时间点。"
                                       Margin="0,4,0,14" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="备份源目录" FontWeight="SemiBold" />
                            <Grid Margin="0,6,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding BackupSourceDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="浏览…" Command="{Binding BrowseBackupSourceCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                            <TextBlock Text="版本库目录" FontWeight="SemiBold" />
                            <Grid Margin="0,6,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding BackupRepositoryDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="浏览…" Command="{Binding BrowseBackupRepositoryCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                            <TextBlock Text="备份模式" FontWeight="SemiBold" />
                            <ComboBox Margin="0,6,0,4" ItemsSource="{Binding BackupModes}"
                                      SelectedItem="{Binding SelectedBackupMode}" DisplayMemberPath="Name" />
                            <TextBlock Text="{Binding SelectedBackupMode.Description}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <CheckBox Margin="0,12,0,0" IsChecked="{Binding BackupUseVss}">
                                <TextBlock Text="使用 Windows VSS 一致性快照（需要管理员权限，仅本机 NTFS 卷）" TextWrapping="Wrap"/>
                            </CheckBox>
                            <Button Margin="0,14,0,0" Content="创建备份快照" Command="{Binding CreateBackupCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button Content="创建 ZIP / 加密归档" Command="{Binding CreateSecureArchiveCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                                <Button Grid.Column="2" Content="恢复安全归档" Command="{Binding RestoreSecureArchiveCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                            <Separator Margin="0,18,0,16" />
                            <TextBlock Text="恢复目标目录" FontWeight="SemiBold" />
                            <Grid Margin="0,6,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding BackupRestoreDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="浏览…" Command="{Binding BrowseBackupRestoreCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                            <CheckBox Content="允许覆盖恢复目录中的已有文件" IsChecked="{Binding BackupRestoreOverwrite}" />
                            <Button Margin="0,12,0,0" Content="恢复所选快照（勾选文件则仅恢复勾选项）"
                                    Command="{Binding RestoreBackupCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBox Text="{Binding BackupKeepLatest, UpdateSourceTrigger=PropertyChanged}" />
                                <Button Grid.Column="2" Content="保留最新数量并清理" Command="{Binding CleanupBackupsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions><RowDefinition Height="210"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Padding="14" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="备份时间点" FontSize="20" FontWeight="SemiBold" />
                                    <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshBackupSnapshotsCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </Grid>
                                <DataGrid Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding BackupSnapshots}"
                                          SelectedItem="{Binding SelectedBackupSnapshot}" AutoGenerateColumns="False" IsReadOnly="True"
                                          CanUserAddRows="False" BorderThickness="0" RowHeaderWidth="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt}" Width="170" />
                                        <DataGridTextColumn Header="模式" Binding="{Binding Mode}" Width="110" />
                                        <DataGridTextColumn Header="文件" Binding="{Binding Files}" Width="80" />
                                        <DataGridTextColumn Header="逻辑大小" Binding="{Binding Size}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                        <Border Grid.Row="2" Padding="14" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="时间点文件（可勾选选择性恢复）" FontSize="18" FontWeight="SemiBold" />
                                <DataGrid Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding BackupFiles}"
                                          AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                                          BorderThickness="0" RowHeaderWidth="0">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="选择" Binding="{Binding IsSelected}" Width="65" />
                                        <DataGridTextColumn Header="相对路径" Binding="{Binding RelativePath}" Width="*" IsReadOnly="True" />
                                        <DataGridTextColumn Header="字节" Binding="{Binding Length}" Width="110" IsReadOnly="True" />
                                        <DataGridTextColumn Header="修改时间" Binding="{Binding ModifiedAt}" Width="170" IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="覆盖版本">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Padding="18" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Text="{Binding VersionsDirectory}" ToolTip="旧版本保存目录"/>
                            <Button Grid.Column="2" Content="浏览…" Command="{Binding BrowseVersionsDirectoryCommand}" Style="{DynamicResource SecondaryButtonStyle}"/>
                            <Button Grid.Column="4" Content="刷新版本" Command="{Binding RefreshVersionsCommand}" Style="{DynamicResource SecondaryButtonStyle}"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="18" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="覆盖前版本" FontSize="20" FontWeight="SemiBold"/><TextBlock Margin="0,4,0,0" Text="恢复会覆盖原目标文件，执行前始终二次确认。旧版无元数据记录可另存恢复。" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel><Button Grid.Column="1" Content="恢复所选版本" Command="{Binding RestoreVersionCommand}" Style="{DynamicResource PrimaryButtonStyle}"/></Grid>
                            <DataGrid Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding FileVersions}" SelectedItem="{Binding SelectedFileVersion}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0" RowHeaderWidth="0"><DataGrid.Columns><DataGridTextColumn Header="保存时间" Binding="{Binding CreatedAt}" Width="170"/><DataGridTextColumn Header="原相对路径" Binding="{Binding RelativePath}" Width="*"/><DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="100"/><DataGridTextColumn Header="版本文件" Binding="{Binding VersionPath}" Width="2*"/></DataGrid.Columns></DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="存储连接与传输">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="230"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Padding="20" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="本地、网络与云端存储连接" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,5,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                                           Text="支持本地/可移动磁盘、MTP 手机/相机、UNC、FTP/FTPS/SFTP、WebDAV、OneDrive、Google Drive、Dropbox、S3、阿里云 OSS、腾讯云 COS 和百度网盘。敏感凭据只保存在 Windows 安全存储。"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="新增连接" Command="{Binding AddStorageConnectionCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                                <Button Margin="8,0,0,0" Content="编辑" Command="{Binding EditStorageConnectionCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Margin="8,0,0,0" Content="测试连接" Command="{Binding TestStorageConnectionCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Margin="8,0,0,0" Content="删除" Command="{Binding DeleteStorageConnectionCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <DataGrid ItemsSource="{Binding StorageConnections}" SelectedItem="{Binding SelectedStorageConnection}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  BorderThickness="0" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180"/>
                                <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="180"/>
                                <DataGridTextColumn Header="端点 / 路径" Binding="{Binding Endpoint}" Width="*"/>
                                <DataGridTextColumn Header="根目录" Binding="{Binding RootPath}" Width="160"/>
                                <DataGridTextColumn Header="凭据" Binding="{Binding CredentialState}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Row="3" Padding="18" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="跨存储目录传输" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,4,0,14" Text="源端和目标端均使用统一流式接口，不把云端凭据写入任务或日志。"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                                <TextBlock Text="源连接" FontWeight="SemiBold"/>
                                <ComboBox Margin="0,6,0,10" ItemsSource="{Binding StorageConnections}"
                                          SelectedItem="{Binding SelectedTransferSource}" DisplayMemberPath="Name"/>
                                <TextBlock Text="源端相对目录（留空表示连接根目录）" FontWeight="SemiBold"/>
                                <TextBox Margin="0,6,0,0" Text="{Binding StorageSourceDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="目标连接" FontWeight="SemiBold"/>
                                <ComboBox Margin="0,6,0,10" ItemsSource="{Binding StorageConnections}"
                                          SelectedItem="{Binding SelectedTransferTarget}" DisplayMemberPath="Name"/>
                                <TextBlock Text="目标端相对目录（留空表示连接根目录）" FontWeight="SemiBold"/>
                                <TextBox Margin="0,6,0,10" Text="{Binding StorageTargetDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                                <CheckBox Content="允许覆盖目标同名文件" IsChecked="{Binding StorageTransferOverwrite}" Foreground="{DynamicResource WarningBrush}"/>
                                <TextBlock Margin="0,10,0,0" Text="{Binding StorageTransferSummary}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="预览" Command="{Binding PreviewStorageTransferCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button Margin="8,0,0,0" Content="开始传输" Command="{Binding ExecuteStorageTransferCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="任务恢复">
                <Border Margin="0,12,0,0" Padding="18" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="未完成任务恢复" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,4,0,0" Text="应用异常退出或手动取消后，可重新扫描并从安全检查点继续。"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="刷新" Command="{Binding RefreshIncompleteCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Margin="8,0,0,0" Content="继续所选任务" Command="{Binding ResumeIncompleteCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding IncompleteExecutions}"
                                  SelectedItem="{Binding SelectedIncompleteExecution}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" BorderThickness="0" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="任务" Binding="{Binding TaskName}" Width="180"/>
                                <DataGridTextColumn Header="开始时间" Binding="{Binding StartedAt}" Width="170"/>
                                <DataGridTextColumn Header="已完成检查点" Binding="{Binding CompletedItems}" Width="120"/>
                                <DataGridTextColumn Header="源" Binding="{Binding Source}" Width="*"/>
                                <DataGridTextColumn Header="目标" Binding="{Binding Target}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="结果通知">
                <Border Margin="0,12,0,0" Padding="18" Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="邮件与 Webhook 通知" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,4,0,0" Text="仅发送任务名称、状态、计数和字节数摘要，不发送文件内容或凭据。"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="新增" Command="{Binding AddNotificationChannelCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                                <Button Margin="8,0,0,0" Content="编辑" Command="{Binding EditNotificationChannelCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Margin="8,0,0,0" Content="发送测试" Command="{Binding TestNotificationChannelCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Margin="8,0,0,0" Content="删除" Command="{Binding DeleteNotificationChannelCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                        <DataGrid Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding NotificationChannels}"
                                  SelectedItem="{Binding SelectedNotificationChannel}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" BorderThickness="0" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="180"/>
                                <DataGridTextColumn Header="类型" Binding="{Binding Kind}" Width="100"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Enabled}" Width="80"/>
                                <DataGridTextColumn Header="端点" Binding="{Binding Endpoint}" Width="*"/>
                                <DataGridTextColumn Header="收件人" Binding="{Binding Recipients}" Width="220"/>
                                <DataGridTextColumn Header="触发事件" Binding="{Binding Events}" Width="190"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="插件">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="180"/></Grid.RowDefinitions>
                    <Border Padding="18" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="插件扩展" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,4,0,0" Text="{Binding PluginDirectory}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBlock Margin="0,4,0,0" Text="每个插件放在独立子目录并提供 plugin.json；重启 CopyTools 后加载。坏插件会显示在下方诊断中，不会阻止主程序启动。"
                                       TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                        </StackPanel>
                    </Border>
                    <DataGrid Grid.Row="1" Margin="0,12,0,0" ItemsSource="{Binding Plugins}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" BorderThickness="0" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="220"/>
                            <DataGridTextColumn Header="API" Binding="{Binding Version}" Width="90"/>
                            <DataGridTextColumn Header="存储适配器" Binding="{Binding StorageAdapters}" Width="110"/>
                            <DataGridTextColumn Header="校验器" Binding="{Binding VerificationProviders}" Width="90"/>
                            <DataGridTextColumn Header="目录" Binding="{Binding Directory}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="3" Padding="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <DataGrid ItemsSource="{Binding PluginDiagnostics}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0" RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="插件清单" Binding="{Binding Path}" Width="*"/>
                                <DataGridTextColumn Header="诊断" Binding="{Binding Message}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="模板与重复文件">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="430"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Padding="18" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="规则与任务模板" FontSize="20" FontWeight="SemiBold"/>
                            <TextBlock Margin="0,10,0,0" Text="模板名称" FontWeight="SemiBold"/><TextBox Margin="0,5,0,10" Text="{Binding NewTemplateName}"/>
                            <TextBlock Text="过滤规则模板" FontWeight="SemiBold"/>
                            <ListBox Height="120" Margin="0,5,0,0" ItemsSource="{Binding FilterTemplates}" SelectedItem="{Binding SelectedFilterTemplate}" DisplayMemberPath="Name"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><Button Content="保存当前过滤" Command="{Binding SaveFilterTemplateCommand}" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="6,0,0,0" Content="应用" Command="{Binding ApplyFilterTemplateCommand}" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="6,0,0,0" Content="删除" Command="{Binding DeleteFilterTemplateCommand}" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel>
                            <TextBlock Margin="0,16,0,0" Text="任务模板（不含源和目标路径）" FontWeight="SemiBold"/>
                            <ListBox Height="120" Margin="0,5,0,0" ItemsSource="{Binding TaskTemplates}" SelectedItem="{Binding SelectedTaskTemplate}" DisplayMemberPath="Name"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"><Button Content="保存当前配置" Command="{Binding SaveTaskTemplateCommand}" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="6,0,0,0" Content="应用" Command="{Binding ApplyTaskTemplateCommand}" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="6,0,0,0" Content="删除" Command="{Binding DeleteTaskTemplateCommand}" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="18" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="210"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel><TextBlock Text="重复文件检测" FontSize="20" FontWeight="SemiBold"/><TextBlock Margin="0,4,0,0" Text="按大小预筛后计算 SHA-256；这里只检测和报告，不提供删除按钮。" Foreground="{DynamicResource MutedTextBrush}"/><TextBox Height="58" Margin="0,10,0,0" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Text="{Binding DuplicateScanPaths}"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button Content="添加目录…" Command="{Binding BrowseDuplicateDirectoryCommand}" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="8,0,0,0" Content="开始扫描" Command="{Binding ScanDuplicatesCommand}" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel><TextBlock Margin="0,8,0,0" Text="{Binding DuplicateSummary}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel>
                            <DataGrid Grid.Row="1" Margin="0,10,0,0" ItemsSource="{Binding DuplicateGroups}" SelectedItem="{Binding SelectedDuplicateGroup}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0" RowHeaderWidth="0"><DataGrid.Columns><DataGridTextColumn Header="哈希" Binding="{Binding Hash}" Width="*"/><DataGridTextColumn Header="数量" Binding="{Binding Count}" Width="70"/><DataGridTextColumn Header="单文件" Binding="{Binding Size}" Width="100"/><DataGridTextColumn Header="可释放" Binding="{Binding Reclaimable}" Width="100"/></DataGrid.Columns></DataGrid>
                            <DataGrid Grid.Row="2" Margin="0,10,0,0" ItemsSource="{Binding SelectedDuplicateGroup.Files}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" BorderThickness="0" RowHeaderWidth="0"><DataGrid.Columns><DataGridTextColumn Header="重复文件路径" Binding="{Binding Path}" Width="*"/><DataGridTextColumn Header="字节" Binding="{Binding Length}" Width="110"/></DataGrid.Columns></DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="应用设置">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto"><Border Padding="24" MaxWidth="920" HorizontalAlignment="Left"
                        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10">
                    <StackPanel Width="820">
                        <TextBlock Text="应用设置" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="这些设置保存在本机，不包含用户文件内容或凭据。"
                                   Margin="0,4,0,18" Foreground="{DynamicResource MutedTextBrush}" />
                        <CheckBox Content="启用计划任务和错误桌面通知"
                                  IsChecked="{Binding NotificationsEnabled}" />
                        <CheckBox Margin="0,12,0,0" Content="最小化或关闭窗口时继续在系统托盘运行"
                                  IsChecked="{Binding MinimizeToTray}" />
                        <CheckBox Margin="0,12,0,0" Content="登录 Windows 后自动启动 CopyTools"
                                  IsChecked="{Binding StartWithWindows}" />
                        <TextBlock Margin="0,18,0,0" Text="运行日志保留天数" FontWeight="SemiBold" />
                        <TextBox Margin="0,6,0,0" Width="180" HorizontalAlignment="Left"
                                 Text="{Binding LogRetentionDays, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,14,0,0" Text="后台服务日志级别" FontWeight="SemiBold" />
                        <ComboBox Margin="0,6,0,0" Width="220" HorizontalAlignment="Left" ItemsSource="{Binding LogLevels}" SelectedItem="{Binding LogLevel}" />
                        <Grid Margin="0,14,0,0" Width="440" HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="后台最大并发文件" FontWeight="SemiBold"/><TextBox Margin="0,6,0,0" Text="{Binding BackgroundMaxParallelFiles}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="后台限速 MB/s（0=不限）" FontWeight="SemiBold"/><TextBox Margin="0,6,0,0" Text="{Binding BackgroundSpeedLimitMbPerSecond}"/></StackPanel>
                        </Grid>
                        <TextBlock Margin="0,18,0,0" Text="主题" FontWeight="SemiBold" />
                        <ComboBox Margin="0,6,0,0" Width="220" HorizontalAlignment="Left" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"/>
                        <TextBlock Margin="0,14,0,0" Text="界面语言" FontWeight="SemiBold" />
                        <ComboBox Margin="0,6,0,0" Width="220" HorizontalAlignment="Left" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"/>
                        <TextBlock Margin="0,5,0,0" Text="当前完整语言包为简体中文；en-US 与 System 已预留资源选择，未翻译文本回退中文。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                        <Separator Margin="0,18,0,14"/>
                        <TextBlock Text="网络代理" FontSize="18" FontWeight="SemiBold"/>
                        <CheckBox Margin="0,10,0,0" Content="无自定义代理时使用 Windows 系统代理" IsChecked="{Binding UseSystemProxy}"/>
                        <TextBlock Margin="0,10,0,0" Text="自定义代理 URL（可留空）" FontWeight="SemiBold"/>
                        <TextBox Margin="0,5,0,0" Text="{Binding ProxyUrl}"/>
                        <TextBlock Margin="0,10,0,0" Text="代理用户名" FontWeight="SemiBold"/>
                        <TextBox Margin="0,5,0,0" Text="{Binding ProxyUserName}"/>
                        <TextBlock Margin="0,10,0,0" Text="代理密码（留空保留已有安全凭据）" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="ProxyPasswordBox" Margin="0,5,0,0" PasswordChanged="ProxyPasswordBox_OnPasswordChanged"/>
                        <TextBlock Margin="0,5,0,0" Text="代理修改在保存后对新建网络连接生效；密码存入 Windows 安全存储。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                        <Separator Margin="0,18,0,14"/>
                        <TextBlock Text="最近与收藏路径" FontSize="18" FontWeight="SemiBold"/>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="最近路径" FontWeight="SemiBold"/><ListBox Height="110" Margin="0,5,0,0" ItemsSource="{Binding RecentPaths}" SelectedItem="{Binding SelectedRecentPath}"/><Button Margin="0,6,0,0" Content="设为源目录" Command="{Binding UseRecentAsSourceCommand}" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="收藏路径" FontWeight="SemiBold"/><ListBox Height="110" Margin="0,5,0,0" ItemsSource="{Binding FavoritePaths}" SelectedItem="{Binding SelectedFavoritePath}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><Button Content="设为源" Command="{Binding UseFavoriteAsSourceCommand}" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="6,0,0,0" Content="设为目标" Command="{Binding UseFavoriteAsTargetCommand}" Style="{StaticResource SecondaryButtonStyle}"/><Button Margin="6,0,0,0" Content="移除" Command="{Binding RemoveFavoriteCommand}" Style="{StaticResource SecondaryButtonStyle}"/></StackPanel></StackPanel>
                        </Grid>
                        <Button Margin="0,10,0,0" Content="收藏当前源和目标路径" Command="{Binding AddCurrentPathsToFavoritesCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button Content="保存设置" Command="{Binding SaveSettingsCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <Button Margin="10,0,0,0" Content="恢复默认" Command="{Binding ResetSettingsCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                        </StackPanel>
                        <Separator Margin="0,18,0,14"/>
                        <TextBlock Text="配置备份与恢复" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,5,0,0" Text="备份包含任务、计划、编排、连接元数据、通知、模板和应用设置；密码、访问令牌等 Windows 安全凭据始终排除。" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="备份完整配置…" Command="{Binding ExportConfigurationCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button Margin="10,0,0,0" Content="恢复完整配置…" Command="{Binding RestoreConfigurationCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                        <Separator Margin="0,18,0,14"/>
                        <TextBlock Text="应用更新" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Margin="0,8,0,0" Text="更新清单 URL 或本地路径" FontWeight="SemiBold"/>
                        <TextBox Margin="0,5,0,0" Text="{Binding UpdateManifestUrl, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Margin="0,8,0,0" Content="应用启动后自动检查更新" IsChecked="{Binding CheckUpdatesOnStartup}"/>
                        <TextBlock Margin="0,6,0,0" Text="{Binding UpdateStatus}" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="检查更新" Command="{Binding CheckUpdateCommand}" Style="{DynamicResource SecondaryButtonStyle}"/>
                            <Button Margin="10,0,0,0" Content="下载并校验更新包…" Command="{Binding DownloadUpdateCommand}" Style="{DynamicResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border></ScrollViewer>
            </TabItem>

            <TabItem Header="实时与设备触发">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="400"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Padding="20" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <StackPanel>
                            <TextBlock Text="自动触发规则" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="文件变化只负责触发；实际执行仍会完整扫描目录差异。"
                                       Margin="0,4,0,16" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="已保存任务" FontWeight="SemiBold" />
                            <ComboBox Margin="0,6,0,12" ItemsSource="{Binding SavedTasks}"
                                      SelectedItem="{Binding SelectedTaskForSchedule}" DisplayMemberPath="Name" />
                            <CheckBox Content="启用规则" IsChecked="{Binding AutoTriggerEnabled}" />
                            <CheckBox Margin="0,10,0,0" Content="文件变化触发（关闭时为源/目标路径重新可用触发）"
                                      IsChecked="{Binding AutoTriggerFileChange}" />
                            <TextBlock Margin="0,14,0,0" Text="变化稳定等待秒数" FontWeight="SemiBold" />
                            <TextBox Margin="0,6,0,0" Text="{Binding AutoTriggerDelaySeconds, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Margin="0,14,0,0" Content="允许自动覆盖" IsChecked="{Binding AutoTriggerAllowOverwrite}"
                                      Foreground="{DynamicResource WarningBrush}" />
                            <CheckBox Margin="0,8,0,16" Content="允许自动隔离或清理" IsChecked="{Binding AutoTriggerAllowQuarantine}"
                                      Foreground="{DynamicResource WarningBrush}" />
                            <Button Content="保存自动触发规则" Command="{Binding SaveAutoTriggerCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                            <TextBlock Margin="0,12,0,0" Text="规则保存或删除后立即重新加载监控，应用重启后也会自动恢复。"
                                       TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="18" Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="已保存规则" FontSize="20" FontWeight="SemiBold" />
                                <Button Grid.Column="1" Content="删除所选" Command="{Binding DeleteAutoTriggerCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" />
                            </Grid>
                            <DataGrid Grid.Row="1" Margin="0,14,0,0" ItemsSource="{Binding AutoTriggerRules}"
                                      SelectedItem="{Binding SelectedAutoTriggerRule}" AutoGenerateColumns="False"
                                      IsReadOnly="True" CanUserAddRows="False" BorderThickness="0" RowHeaderWidth="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="任务" Binding="{Binding Name}" Width="180" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding Enabled}" Width="70" />
                                    <DataGridTextColumn Header="触发" Binding="{Binding Kind}" Width="120" />
                                    <DataGridTextColumn Header="去抖" Binding="{Binding Delay}" Width="90" />
                                    <DataGridTextColumn Header="自动安全授权" Binding="{Binding Safety}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" Margin="2,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="5" />
                <RowDefinition Height="3" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />
            <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding CurrentFileProgressPercent, Mode=OneWay}"
                         Foreground="#38BDF8" />
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <TextBlock Text="{Binding TransferStatistics}" Margin="0,2,0,0" FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Content="重试失败项" Command="{Binding RetryFailuresCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Grid.Column="3" Content="暂停" Command="{Binding PauseCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Grid.Column="5" Content="继续" Command="{Binding ResumeCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Grid.Column="7" Content="取消" Command="{Binding CancelCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Grid.Column="9" Content="开始执行" Command="{Binding ExecuteCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Grid>
        </Grid>
    </Grid>
</Window>

