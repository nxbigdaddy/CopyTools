<Window x:Class="CopyTools.Desktop.StorageConnectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="存储连接" Width="620" Height="690" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="{DynamicResource PageBackgroundBrush}" ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.ColumnSpan="2" Text="存储连接" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,18" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                       Text="配置只保存端点与凭据引用。密码、访问令牌和密钥写入 Windows 凭据管理器或当前用户 DPAPI 安全存储。"/>

            <TextBlock Grid.Row="2" Text="类型" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox x:Name="KindBox" Grid.Row="2" Grid.Column="1" Margin="0,5" DisplayMemberPath="Name"
                      SelectionChanged="KindBox_OnSelectionChanged"/>
            <TextBlock Grid.Row="3" Text="连接名称" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="NameBox" Grid.Row="3" Grid.Column="1" Margin="0,5"/>
            <TextBlock Grid.Row="4" Text="端点 / 本地路径" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <Grid Grid.Row="4" Grid.Column="1" Margin="0,5">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="EndpointBox"/>
                <Button x:Name="BrowseButton" Grid.Column="1" Margin="8,0,0,0" Padding="12,4" Content="选择…"
                        Click="BrowseButton_OnClick"/>
            </Grid>
            <TextBlock Grid.Row="5" Text="根目录 / 文件夹 ID" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="RootPathBox" Grid.Row="5" Grid.Column="1" Margin="0,5"/>
            <TextBlock Grid.Row="6" Text="用户名 / Access Key" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="UserNameBox" Grid.Row="6" Grid.Column="1" Margin="0,5"/>
            <TextBlock Grid.Row="7" Text="区域" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="RegionBox" Grid.Row="7" Grid.Column="1" Margin="0,5"/>
            <TextBlock Grid.Row="8" Text="存储桶" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="BucketBox" Grid.Row="8" Grid.Column="1" Margin="0,5"/>
            <TextBlock Grid.Row="9" Text="密码 / 令牌 / 密钥" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <StackPanel Grid.Row="9" Grid.Column="1" Margin="0,5">
                <PasswordBox x:Name="SecretBox"/>
                <TextBlock x:Name="SecretHint" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
            </StackPanel>

            <Grid Grid.Row="10" Grid.ColumnSpan="2" Margin="0,24,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="HelpText" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                <Button Grid.Column="1" Margin="12,0,8,0" Padding="18,7" Content="取消" IsCancel="True"/>
                <Button Grid.Column="2" Padding="18,7" Content="保存" IsDefault="True" Click="SaveButton_OnClick"
                        Style="{DynamicResource PrimaryButtonStyle}"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
