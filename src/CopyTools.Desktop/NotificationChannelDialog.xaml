<Window x:Class="CopyTools.Desktop.NotificationChannelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="通知频道" Width="540" Height="650" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
        <TextBlock Text="通知频道" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Margin="0,12,0,0" Text="名称" FontWeight="SemiBold"/><TextBox x:Name="NameInput" Margin="0,5,0,0"/>
        <TextBlock Margin="0,12,0,0" Text="类型" FontWeight="SemiBold"/>
        <ComboBox x:Name="KindInput" Margin="0,5,0,0" SelectionChanged="KindChanged">
            <ComboBoxItem Content="Webhook" Tag="Webhook"/><ComboBoxItem Content="SMTP 邮件" Tag="Smtp"/>
        </ComboBox>
        <CheckBox x:Name="EnabledInput" Margin="0,12,0,0" Content="启用频道"/>
        <TextBlock Margin="0,12,0,0" Text="端点" FontWeight="SemiBold"/><TextBox x:Name="EndpointInput" Margin="0,5,0,0"/>
        <TextBlock x:Name="EndpointHelp" Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
        <TextBlock x:Name="UserLabel" Margin="0,12,0,0" Text="用户名" FontWeight="SemiBold"/><TextBox x:Name="UserInput" Margin="0,5,0,0"/>
        <TextBlock Margin="0,12,0,0" Text="令牌或密码（留空保留已有安全凭据）" FontWeight="SemiBold"/>
        <PasswordBox x:Name="SecretInput" Margin="0,5,0,0"/>
        <TextBlock x:Name="SenderLabel" Margin="0,12,0,0" Text="发件人" FontWeight="SemiBold"/><TextBox x:Name="SenderInput" Margin="0,5,0,0"/>
        <TextBlock x:Name="RecipientsLabel" Margin="0,12,0,0" Text="收件人（分号或逗号分隔）" FontWeight="SemiBold"/><TextBox x:Name="RecipientsInput" Margin="0,5,0,0"/>
        <CheckBox x:Name="SuccessInput" Margin="0,14,0,0" Content="任务成功时通知"/>
        <CheckBox x:Name="FailureInput" Margin="0,8,0,0" Content="任务失败或部分成功时通知"/>
        <TextBlock Margin="0,12,0,0" Text="敏感值保存在 Windows 安全存储，普通数据库中只有凭据引用。" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Width="90" Content="取消" IsCancel="True"/>
            <Button Width="100" Margin="10,0,0,0" Content="保存" IsDefault="True" Click="SaveClick"/>
        </StackPanel>
    </StackPanel></ScrollViewer>
</Window>
