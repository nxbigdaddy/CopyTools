<Window x:Class="CopyTools.Desktop.ConflictResolutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="解决双向同步冲突" Width="620" Height="330" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="双方都修改了同一文件" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Margin="0,8,0,0" Text="{Binding RelativePath}" TextWrapping="Wrap"/>
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Padding="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock Text="源端版本" FontWeight="SemiBold"/><TextBlock Margin="0,6,0,0" Text="{Binding SourcePath}" TextWrapping="Wrap"/><TextBlock Margin="0,6,0,0" Text="{Binding SourceDetails}"/></StackPanel></Border>
            <Border Grid.Column="2" Padding="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock Text="目标端版本" FontWeight="SemiBold"/><TextBlock Margin="0,6,0,0" Text="{Binding TargetPath}" TextWrapping="Wrap"/><TextBlock Margin="0,6,0,0" Text="{Binding TargetDetails}"/></StackPanel></Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="保留源端" Click="Source_Click" Style="{DynamicResource SecondaryButtonStyle}"/>
            <Button Margin="8,0,0,0" Content="保留目标端" Click="Target_Click" Style="{DynamicResource SecondaryButtonStyle}"/>
            <Button Margin="8,0,0,0" Content="保留两份" Click="Both_Click" Style="{DynamicResource PrimaryButtonStyle}"/>
            <Button Margin="8,0,0,0" Content="取消" IsCancel="True" Style="{DynamicResource SecondaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
